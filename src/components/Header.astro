---
import Icon from "./Icon.astro";
import { site, navigation } from "../data/site";

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
const groupActive = (children?: { href: string }[]) =>
  (children ?? []).some((c) => isActive(c.href));
---

<div class="bg-brand-950 text-white text-[13px]">
  <div class="container-page flex items-center justify-between gap-4 py-2">
    <p class="hidden md:flex items-center gap-2 text-brand-100">
      <span class="inline-block h-2 w-2 rounded-full bg-saffron-400"></span>
      Government of Himachal Pradesh &middot; DTEV&amp;IT
    </p>
    <div class="flex w-full md:w-auto items-center justify-between md:justify-end gap-1 sm:gap-2">
      <a href="/screen-reader-access/" class="rounded px-2 py-1 text-brand-100 hover:bg-white/10 hover:text-white">Screen Reader</a>
      <span class="text-brand-700">|</span>
      <a href="/sitemap/" class="rounded px-2 py-1 text-brand-100 hover:bg-white/10 hover:text-white">Sitemap</a>
      <span class="hidden sm:inline text-brand-700">|</span>
      <div class="hidden sm:flex items-center gap-1" role="group" aria-label="Text size">
        <span class="px-1 text-brand-300" aria-hidden="true">A</span>
        <button type="button" data-font="dec" class="rounded px-2 py-1 text-brand-100 hover:bg-white/10" aria-label="Decrease font size">A-</button>
        <button type="button" data-font="reset" class="rounded px-2 py-1 text-brand-100 hover:bg-white/10" aria-label="Reset font size">A</button>
        <button type="button" data-font="inc" class="rounded px-2 py-1 text-brand-100 hover:bg-white/10" aria-label="Increase font size">A+</button>
      </div>
      <span class="hidden sm:inline text-brand-700">|</span>
      <button type="button" data-contrast-toggle class="flex items-center gap-1.5 rounded px-2 py-1 text-brand-100 hover:bg-white/10 hover:text-white" aria-pressed="false">
        <Icon name="eye" size={15} />
        <span class="hidden lg:inline">Contrast</span>
      </button>
    </div>
  </div>
</div>

<header class="bg-white border-b border-ink-100">
  <div class="container-page flex items-center justify-between gap-4 py-4 lg:py-5">
    <a href="/" class="flex items-center gap-3 sm:gap-4 min-w-0">
      <img
        src="/images/179Logo-Header-hp.jpg"
        alt="Emblem of Govt. ITI Summerkot"
        width="398"
        height="126"
        class="h-12 sm:h-14 w-auto shrink-0"
      />
      <span class="min-w-0">
        <span class="block font-display text-[15px] leading-tight font-extrabold tracking-tight text-brand-950 sm:text-lg lg:text-xl">
          Govt. Industrial Training Institute, Summerkot
        </span>
        <span class="mt-0.5 block text-[11px] font-medium text-ink-500 sm:text-xs lg:text-sm">
          {site.tagline}
        </span>
        <span class="mt-0.5 hidden text-xs text-ink-400 sm:block">{site.address}</span>
      </span>
    </a>

    <div class="hidden xl:flex items-center gap-2">
      <a href="/downloads/" class="btn btn-outline">
        <Icon name="download" size={17} /> Prospectus
      </a>
      <a href="https://linktr.ee/nimichennai" target="_blank" rel="noopener" class="btn btn-outline">
        NIMI Learning
      </a>
      <a href="/contact-us/" class="btn btn-accent">
        <Icon name="phone" size={17} /> Contact Us
      </a>
    </div>

    <button
      type="button"
      id="mobile-toggle"
      class="xl:hidden inline-flex items-center justify-center rounded-lg border border-ink-200 p-2.5 text-brand-900 hover:bg-ink-50"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" size={22} />
    </button>
  </div>
</header>

<nav id="primary-nav" class="sticky top-0 z-40 bg-brand-900 text-white shadow-md" aria-label="Primary">
  <div class="container-page">
    <ul class="hidden xl:flex items-stretch">
      {
        navigation.map((item) => (
          <li class="relative group">
            {item.children ? (
              <button
                type="button"
                class:list={[
                  "nav-trigger flex h-full items-center gap-1.5 px-4 py-3.5 text-sm font-semibold transition-colors hover:bg-brand-800",
                  groupActive(item.children) && "bg-brand-800 text-white",
                ]}
                aria-expanded="false"
              >
                {item.label}
                <Icon name="chevron-down" size={15} class="transition-transform group-hover:rotate-180" />
              </button>
              <div class="nav-panel invisible absolute left-0 top-full z-50 w-80 translate-y-1 opacity-0 transition-all duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                <ul class="mt-0 overflow-hidden rounded-b-xl border border-brand-800 bg-white py-2 shadow-2xl">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        target={child.external ? "_blank" : undefined}
                        rel={child.external ? "noopener" : undefined}
                        class:list={[
                          "flex items-center justify-between gap-3 px-4 py-2.5 text-sm text-ink-700 transition-colors hover:bg-brand-50 hover:text-brand-800",
                          isActive(child.href) && "bg-brand-50 font-semibold text-brand-800",
                        ]}
                      >
                        <span>{child.label}</span>
                        {child.external && <Icon name="external-link" size={14} class="text-ink-400" />}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ) : (
              <a
                href={item.href}
                class:list={[
                  "flex h-full items-center px-4 py-3.5 text-sm font-semibold transition-colors hover:bg-brand-800",
                  isActive(item.href!) && "bg-brand-800 shadow-[inset_0_-3px_0_0_var(--color-saffron-400)]",
                ]}
              >
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>

    <ul id="mobile-menu" class="xl:hidden hidden divide-y divide-brand-800/60 pb-2">
      {
        navigation.map((item) => (
          <li>
            {item.children ? (
              <details class="group">
                <summary class="flex cursor-pointer list-none items-center justify-between px-1 py-3.5 text-sm font-semibold marker:content-none">
                  {item.label}
                  <Icon name="chevron-down" size={16} class="transition-transform group-open:rotate-180" />
                </summary>
                <ul class="mb-2 space-y-0.5 rounded-lg bg-brand-950/40 p-2">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        target={child.external ? "_blank" : undefined}
                        rel={child.external ? "noopener" : undefined}
                        class:list={[
                          "block rounded-md px-3 py-2 text-sm text-brand-100 hover:bg-white/10 hover:text-white",
                          isActive(child.href) && "bg-white/10 font-semibold text-white",
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={item.href}
                class:list={[
                  "block px-1 py-3.5 text-sm font-semibold",
                  isActive(item.href!) && "text-saffron-300",
                ]}
              >
                {item.label}
              </a>
            )}
          </li>
        ))
      }
      <li class="flex gap-2 pt-3">
        <a href="/downloads/" class="btn btn-ghost-light flex-1 text-xs">Prospectus</a>
        <a href="/contact-us/" class="btn btn-accent flex-1 text-xs">Contact Us</a>
      </li>
    </ul>
  </div>
</nav>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var mobileToggle = document.getElementById("mobile-toggle");
    var mobileMenu = document.getElementById("mobile-menu");
    if (mobileToggle && mobileMenu) {
      mobileToggle.addEventListener("click", function () {
        var open = mobileMenu.classList.toggle("hidden");
        mobileToggle.setAttribute("aria-expanded", String(!open));
      });
    }

    // Keyboard support: dropdowns open on hover (CSS) and while focus is within
    document.querySelectorAll(".nav-trigger").forEach(function (btn) {
      var setExpanded = function (v) {
        btn.setAttribute("aria-expanded", String(v));
      };
      var li = btn.closest("li");
      if (!li) return;
      li.addEventListener("mouseenter", function () { setExpanded(true); });
      li.addEventListener("mouseleave", function () { setExpanded(false); });
      li.addEventListener("focusin", function () { setExpanded(true); });
      li.addEventListener("focusout", function () { setExpanded(false); });
    });
    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && mobileMenu && !mobileMenu.classList.contains("hidden")) {
        mobileMenu.classList.add("hidden");
        if (mobileToggle) mobileToggle.setAttribute("aria-expanded", "false");
      }
    });

    // Font size controls
    var scales = [0.9, 1, 1.12, 1.25];
    var idx = 1;
    try {
      var saved = parseFloat(localStorage.getItem("iti-font-scale"));
      if (!isNaN(saved) && scales.indexOf(saved) !== -1) idx = scales.indexOf(saved);
    } catch (e) {}
    function applyScale() {
      root.style.setProperty("--font-scale", String(scales[idx]));
      try { localStorage.setItem("iti-font-scale", String(scales[idx])); } catch (e) {}
    }
    document.querySelectorAll("[data-font]").forEach(function (b) {
      b.addEventListener("click", function () {
        var dir = b.getAttribute("data-font");
        if (dir === "inc") idx = Math.min(scales.length - 1, idx + 1);
        else if (dir === "dec") idx = Math.max(0, idx - 1);
        else idx = 1;
        applyScale();
      });
    });

    // High contrast toggle
    var ct = document.querySelector("[data-contrast-toggle]");
    function applyContrast(on) {
      if (on) root.setAttribute("data-contrast", "high");
      else root.removeAttribute("data-contrast");
      if (ct) ct.setAttribute("aria-pressed", String(on));
      try { localStorage.setItem("iti-contrast", on ? "high" : "normal"); } catch (e) {}
    }
    if (ct) {
      ct.addEventListener("click", function () {
        applyContrast(root.getAttribute("data-contrast") !== "high");
      });
      if (root.getAttribute("data-contrast") === "high") ct.setAttribute("aria-pressed", "true");
    }
  })();
</script>
