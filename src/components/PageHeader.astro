---
import Icon from "./Icon.astro";

export interface Props {
  title: string;
  subtitle?: string;
  parent?: string;
  parentHref?: string;
}

const { title, subtitle, parent = "Home", parentHref = "/" } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-brand-950 via-brand-900 to-brand-800">
  <div
    class="pointer-events-none absolute inset-0 opacity-20"
    style="background-image: radial-gradient(circle at 20% 20%, rgba(255,171,36,.5), transparent 40%), radial-gradient(circle at 80% 0%, rgba(91,132,251,.5), transparent 45%);"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image: linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px); background-size: 44px 44px;"
  >
  </div>
  <div class="container-page relative py-12 sm:py-16">
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-brand-200">
        <li class="flex items-center gap-2">
          <a href={parentHref} class="inline-flex items-center gap-1.5 hover:text-white">
            <Icon name="home" size={15} /> {parent}
          </a>
        </li>
        <li class="flex items-center gap-2">
          <Icon name="chevron-down" size={14} class="-rotate-90 text-brand-400" />
          <span class="font-medium text-saffron-300" aria-current="page">{title}</span>
        </li>
      </ol>
    </nav>
    <h1 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-[2.75rem]">
      {title}
    </h1>
    {subtitle && <p class="mt-3 max-w-3xl text-base leading-relaxed text-brand-100 sm:text-lg">{subtitle}</p>}
  </div>
</section>
