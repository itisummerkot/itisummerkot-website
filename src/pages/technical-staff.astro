---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import DataTable from "../components/DataTable.astro";

const rows = [
  ["Rajnish Chauhan", "Group Instructor / DDO"],
  ["Rajesh Kumar", "Instructor Drawing / Math"],
  ["Vijay Prakash", "Instructor Electrician"],
];
---

<BaseLayout title="Technical Staff" description="Technical staff of Govt. ITI Summerkot.">
  <PageHeader title="Technical Staff" subtitle="Instructors delivering trade practicals, theory and related subjects." />
  <section class="container-page py-12 lg:py-16">
    <div class="mx-auto max-w-3xl">
      <DataTable headers={["Name", "Designation"]} rows={rows} minWidth="28rem" />
    </div>
  </section>
</BaseLayout>
