---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import EmptyState from "../components/EmptyState.astro";
---

<BaseLayout title="Tenders" description="Tender notices issued by Govt. ITI Summerkot.">
  <PageHeader title="Tenders" subtitle="Notices inviting bids and quotations." />
  <section class="container-page py-12 lg:py-16">
    <div class="mx-auto max-w-4xl">
      <EmptyState title="No tenders are currently open" message="New tender notices will be published on this page as and when issued. Please check back for updates." />
    </div>
  </section>
</BaseLayout>
