---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import DataTable from "../components/DataTable.astro";

const rows = [
  ["Electrician", "2 Years", "10th Pass"],
  ["COPA", "1 Year", "10th Pass"],
];
---

<BaseLayout title="Admission Criteria" description="Admission criteria, duration and eligibility for trades at Govt. ITI Summerkot.">
  <PageHeader title="Admission Criteria" subtitle="Duration of training and eligibility qualification for each trade." />
  <section class="container-page py-12 lg:py-16">
    <div class="mx-auto max-w-4xl">
      <DataTable headers={["Name of Trade", "Duration of Training", "Eligibility Qualification"]} rows={rows} minWidth="34rem" />
      <div class="mt-8 rounded-2xl border border-ink-100 bg-ink-50 p-6">
        <h2 class="font-display text-lg font-bold text-brand-950">Admissions</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
          Admissions are made through the online counselling process of the Department of Technical
          Education, Vocational &amp; Industrial Training, Himachal Pradesh. For the current-year
          eligibility, seat matrix and prospectus, refer to the official admission portal or contact
          the institute office.
        </p>
        <a href="https://www.hptechboard.com/" target="_blank" rel="noopener" class="btn btn-primary mt-5">
          Admission / OLA Portal
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
