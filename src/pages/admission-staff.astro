---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import DataTable from "../components/DataTable.astro";

const rows = [
  ["Rajnish Chauhan", "Group Instructor / DDO"],
  ["Nishant Bhickta", "JOA (IT)"],
  ["Chet Ram", "Peon"],
];
---

<BaseLayout title="Administrative Staff" description="Administrative staff of Govt. ITI Summerkot.">
  <PageHeader title="Administrative Staff" subtitle="Officers and staff handling the institute's administration." />
  <section class="container-page py-12 lg:py-16">
    <div class="mx-auto max-w-3xl">
      <DataTable headers={["Name", "Designation"]} rows={rows} minWidth="28rem" />
    </div>
  </section>
</BaseLayout>
