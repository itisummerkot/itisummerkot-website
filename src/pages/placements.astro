---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import EmptyState from "../components/EmptyState.astro";
---

<BaseLayout title="Placements" description="Placement records of trainees of Govt. ITI Summerkot.">
  <PageHeader title="Placements" subtitle="Trainees placed in industry and establishments." />
  <section class="container-page py-12 lg:py-16">
    <div class="mx-auto max-w-4xl">
      <EmptyState title="Placement records will be published here" message="Trade-wise placement records are being updated. Employers wishing to recruit our trainees may contact the institute." />
    </div>
  </section>
</BaseLayout>
