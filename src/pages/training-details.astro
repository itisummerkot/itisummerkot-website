---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import DataTable from "../components/DataTable.astro";
import Icon from "../components/Icon.astro";

const rows = [
  ["1", "Electrician", "DGT/1001", "2 Years", "20", "10th Pass"],
  ["2", "COPA", "DGT/1003", "1 Year", "24", "10th Pass"],
];
---

<BaseLayout title="Training Details" description="Trade-wise training details of Govt. ITI Summerkot — Electrician and COPA.">
  <PageHeader title="Training Details" subtitle="Trades offered, duration, sanctioned intake and eligibility." />
  <section class="container-page py-12 lg:py-16">
    <div class="mx-auto max-w-5xl">
      <DataTable
        headers={["Sr. No.", "Name of the Trade", "Trade Code", "Training Duration", "Sanctioned Strength", "Eligibility"]}
        rows={rows}
        minWidth="46rem"
      />
      <p class="mt-6 text-sm text-ink-500">
        Electrician is a two-year trade and COPA is a one-year trade, both affiliated to NCVT.
        Sanctioned strength is per unit.
      </p>
      <div class="mt-6 rounded-2xl border border-saffron-200 bg-saffron-50 p-5 text-sm text-ink-700">
        <p class="flex items-start gap-3">
          <Icon name="calendar" size={18} class="mt-0.5 shrink-0 text-saffron-700" />
          <span>Every year 150 hours of mandatory OJT (On the Job Training) at a nearby industry is
          required; wherever an industry is not available, a group project is mandatory.</span>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
