---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import EmptyState from "../components/EmptyState.astro";
---

<BaseLayout title="Institute Infrastructure" description="Infrastructure and building details of Govt. ITI Summerkot.">
  <PageHeader title="Institute Infrastructure" subtitle="Ownership, buildings and space available with the institute." />
  <section class="container-page py-12 lg:py-16">
    <div class="mx-auto max-w-4xl">
      <EmptyState
        title="Infrastructure details will be published here"
        message="Details of ownership documents, lease agreements and built-up area are being updated. Construction of Block-B of the institution building has been completed and is likely to be handed over to the institute by the construction agency soon."
      />
    </div>
  </section>
</BaseLayout>
